# ServiceNow instance (hostname only) and an admin used to deploy
SN_INSTANCE=devXXXXXX.service-now.com
SN_USER=admin
SN_PASS=

# Dynamics 365 Contact Center
D365_ORG_URL=https://contoso.crm.dynamics.com
D365_APP_ID=
# Softphone: the new Contact Center Edge desktop by default (OpenFrame shows /d365cc_edge.do).
# D365_WIDGET=classic uses the older embeddable conversation widget instead.
# D365_WIDGET=
# Optional: override the OpenFrame URL completely
# D365_WIDGET_URL=

# Used for call titles
TIMEZONE=America/New_York
TIMEZONE_LABEL=ET

